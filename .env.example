# Copy to .env and fill in. In production these are injected via docker-compose.

# Postgres (dev: docker-compose.dev.yml exposes 5432)
DATABASE_URL=postgresql://app:app@localhost:5432/app
POSTGRES_PASSWORD=app

# Redis (dev: docker-compose.dev.yml exposes 6379)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# API key for agent / MCP access (X-API-Key header → synthetic manager session)
AGENT_API_KEY=

# API port (dev)
PORT=3001

# Polymarket connector (all live execution remains disabled until a later explicit implementation).
# Use a dedicated, tightly funded signer. Credential-style values are encrypted at rest when set
# through Admin → Settings; do not commit real values to this file.
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_SIGNER_PRIVATE_KEY=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYGON_RPC_URL=
POLYMARKET_MAX_ORDER_USD=5
POLYMARKET_MAX_OPEN_EXPOSURE_USD=25
POLYMARKET_DAILY_LOSS_LIMIT_USD=20
POLYMARKET_MAX_BOOK_AGE_MS=2000
POLYMARKET_LIVE_EXECUTION_ENABLED=false
