# Copy to .env and fill in. In production these are injected via docker-compose.

# Postgres (dev: docker-compose.dev.yml exposes 5432)
DATABASE_URL=postgresql://app:app@localhost:5432/app
POSTGRES_PASSWORD=app

# Redis (dev: docker-compose.dev.yml exposes 6379)
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# API key for agent / MCP access (X-API-Key header → synthetic manager session)
AGENT_API_KEY=

# API port (dev)
PORT=3001

# Polymarket SYSTEM connector. Per-user wallets, signers, and Relayer keys are encrypted in the
# polymarket_account table and must never be supplied as global environment variables.
POLYMARKET_BUILDER_ADDRESS=
POLYMARKET_BUILDER_CODE=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_API_PASSPHRASE=
POLYGON_RPC_URL=
# Platform-wide ceilings; user wallet limits may be lower but cannot exceed these values.
POLYMARKET_MAX_ORDER_USD=5
POLYMARKET_MAX_OPEN_EXPOSURE_USD=25
POLYMARKET_DAILY_LOSS_LIMIT_USD=20
POLYMARKET_MAX_BOOK_AGE_MS=2000
POLYMARKET_LIVE_EXECUTION_ENABLED=false
